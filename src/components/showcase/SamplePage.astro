---
import Layout from "@/layouts/Layout.astro";
import ShowcaseStage from "./ShowcaseStage.astro";
import ShowcaseBento from "./ShowcaseBento.astro";
import ShowcaseRunway from "./ShowcaseRunway.astro";
import type { ShowcaseLayout } from "@/config/showcase";

interface Props {
  readonly layout: ShowcaseLayout;
  readonly title: string;
}

const { layout, title } = Astro.props;
---

<Layout title={title} robots={{ index: false, follow: false }}>
  {layout === "stage" && <ShowcaseStage />}
  {layout === "bento" && <ShowcaseBento />}
  {layout === "runway" && <ShowcaseRunway />}
  <script>
    const forceLight = () => {
      document.documentElement.dataset.theme = "light";
    };
    forceLight();
    document.addEventListener("DOMContentLoaded", forceLight);
  </script>
</Layout>
