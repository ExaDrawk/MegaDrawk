---
import { SHOWCASE } from "@/config/showcase";

interface Props {
  readonly wide?: boolean;
}

const { wide = false } = Astro.props;
const initial = SHOWCASE[0];
---

<section
  class:list={["runway", { "runway--wide": wide }]}
  data-runway
  aria-label="Google Playのアプリ"
>
  <div class="runway__sticky">
    <div class="runway__monitor">
      <div class="runway__masthead">
        <div class="runway__brand">
          <img
            class="runway__brand-icon"
            src="/icon.svg"
            alt=""
            width="40"
            height="40"
          />
          <img
            class="runway__brand-wordmark"
            src="/logo-horizontal.svg"
            alt="MEGADRAWK"
            width="376"
            height="40"
          />
        </div>
        <h2 class="runway__heading">私の個人制作アプリ</h2>
      </div>

      <div class="runway__viewport">
        <div class="runway__track" data-runway-track>
          {SHOWCASE.map((item) => (
            <a
              class="runway__slide"
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={item.src}
                alt={item.alt}
                width="1664"
                height="940"
                loading="eager"
                decoding="async"
                referrerpolicy="no-referrer"
              />
            </a>
          ))}
        </div>
      </div>

      <div class="runway__caption" aria-live="polite">
        <a
          class="runway__caption-name"
          data-runway-name
          href={initial?.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          {initial?.name}
        </a>
        <p class="runway__caption-description" data-runway-description>
          {initial?.description}
        </p>
      </div>
    </div>

    <div class="runway__controls">
      <div class="runway__index" role="group" aria-label="作品を選択">
        {SHOWCASE.map((item, index) => (
          <button
            class:list={["runway__thumb", { "is-active": index === 0 }]}
            data-runway-thumb
            data-name={item.name}
            data-description={item.description}
            data-href={item.href}
            type="button"
            aria-label={item.alt}
            aria-current={index === 0 ? "true" : "false"}
          >
            <img
              src={item.src}
              alt=""
              width="320"
              height="180"
              loading="eager"
              decoding="async"
              referrerpolicy="no-referrer"
            />
          </button>
        ))}
      </div>
      <div class="runway__progress" aria-hidden="true">
        <span data-runway-progress></span>
      </div>
    </div>
  </div>
</section>

<style>
  .runway {
    padding-block: 18px 0;
  }
  .runway__sticky {
    position: static;
  }
  .runway__monitor {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 1.6vw, 24px);
    min-width: 0;
    padding: clamp(14px, 1.4vw, 22px);
    border: 1px solid var(--color-rule);
    background: var(--color-paper);
  }
  .runway__masthead {
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 1.4vw, 18px);
    animation: runway-masthead-in 0.8s cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }
  .runway__brand {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.2vw, 16px);
  }
  .runway__brand-icon {
    display: block;
    flex: none;
    width: clamp(30px, 2.8vw, 40px);
    height: auto;
  }
  .runway__brand-wordmark {
    display: block;
    width: auto;
    max-width: 100%;
    height: clamp(26px, 2.4vw, 36px);
  }
  .runway__heading {
    margin: 0;
    font-size: clamp(1.55rem, 2.6vw, 2.4rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: var(--color-ink);
  }
  .runway__viewport {
    min-width: 0;
  }
  .runway__track {
    display: flex;
    gap: 12px;
    padding-bottom: 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .runway__track::-webkit-scrollbar {
    display: none;
  }
  .runway__slide {
    flex: 0 0 88%;
    scroll-snap-align: center;
    background: var(--color-paper-2);
  }
  .runway__slide img {
    display: block;
    width: 100%;
    height: auto;
  }
  .runway__caption {
    display: grid;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid var(--color-rule);
  }
  .runway__caption.is-changing .runway__caption-name {
    animation: runway-caption-in 0.5s cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }
  .runway__caption.is-changing .runway__caption-description {
    animation: runway-caption-in 0.65s 0.06s cubic-bezier(0.22, 0.61, 0.36, 1)
      both;
  }
  .runway__caption-name {
    width: fit-content;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-decoration: none;
  }
  .runway__caption-name::after {
    content: " ↗";
    font-size: 0.8em;
    color: var(--color-muted);
  }
  .runway__caption-name:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .runway__caption-description {
    margin: 0;
    max-width: 44rem;
    font-size: 0.9375rem;
    line-height: 1.9;
    color: var(--color-text);
  }
  .runway__controls {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 12px 16px 0;
  }
  .runway__index {
    display: flex;
    gap: 8px;
  }
  .runway__thumb {
    flex: 0 0 auto;
    width: calc((100% - 16px) / 3);
    padding: 0;
    border: 0;
    background: none;
    opacity: 0.46;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }
  .runway__thumb img {
    display: block;
    width: 100%;
    height: auto;
  }
  .runway__thumb.is-active,
  .runway__thumb:hover,
  .runway__thumb:focus-visible {
    opacity: 1;
  }
  .runway__thumb:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }
  .runway__progress {
    display: none;
  }
  .runway.is-enhanced {
    height: 260svh;
    padding: 0;
  }
  .runway.is-enhanced .runway__sticky {
    position: sticky;
    top: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.9fr) minmax(210px, 0.8fr);
    gap: clamp(24px, 3vw, 48px);
    align-items: start;
    height: calc(100svh - var(--header-height));
    padding: clamp(22px, 3vw, 38px) clamp(22px, 3vw, 42px);
    overflow: hidden;
    background: var(--color-paper);
  }
  .runway.is-enhanced .runway__viewport {
    overflow: hidden;
  }
  .runway.is-enhanced .runway__track {
    width: 100%;
    gap: 32px;
    padding: 0;
    overflow: visible;
    scroll-snap-type: none;
    will-change: transform;
  }
  .runway.is-enhanced .runway__slide {
    flex: 0 0 100%;
    width: 100%;
    scroll-snap-align: none;
  }
  .runway.is-enhanced .runway__controls {
    position: static;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 0;
  }
  .runway.is-enhanced .runway__index {
    flex-direction: column;
    gap: 10px;
  }
  .runway.is-enhanced .runway__thumb {
    width: 100%;
    opacity: 0.36;
  }
  .runway.is-enhanced .runway__thumb.is-active {
    opacity: 1;
  }
  .runway.is-enhanced .runway__progress {
    display: block;
    width: 100%;
    height: 1px;
    margin-top: 4px;
    overflow: hidden;
    background: var(--color-rule);
  }
  .runway.is-enhanced .runway__progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-ink);
    transform: scaleX(0);
    transform-origin: left;
  }
  .runway--wide.is-enhanced .runway__sticky {
    grid-template-columns: minmax(0, 1.95fr) minmax(240px, 0.95fr);
  }
  @keyframes runway-masthead-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes runway-caption-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (max-width: 900px) {
    .runway__slide {
      flex-basis: 88%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .runway__masthead,
    .runway__caption.is-changing .runway__caption-name,
    .runway__caption.is-changing .runway__caption-description {
      animation: none;
    }
  }
</style>

<script is:inline src="/scripts/runway.js" defer></script>
