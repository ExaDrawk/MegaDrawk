---
import { SHOWCASE } from "@/config/showcase";
---

<section class="runway" data-runway aria-label="Google Playのアプリ">
  <div class="runway__sticky">
    <div class="runway__track" data-runway-track>
      {SHOWCASE.map((item) => (
        <a
          class="runway__slide"
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            src={item.src}
            alt={item.alt}
            width="1664"
            height="940"
            loading="eager"
            decoding="async"
            referrerpolicy="no-referrer"
          />
        </a>
      ))}
    </div>
    <div class="runway__progress" aria-hidden="true">
      <span data-runway-progress></span>
    </div>
  </div>
</section>

<style>
  .runway {
    padding-block: 32px 0;
  }
  .runway__sticky {
    position: static;
  }
  .runway__track {
    display: flex;
    gap: 16px;
    padding-bottom: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .runway__track::-webkit-scrollbar {
    display: none;
  }
  .runway__slide {
    flex: 0 0 86%;
    scroll-snap-align: center;
    background: var(--color-paper-2);
  }
  .runway__slide img {
    display: block;
    width: 100%;
    height: auto;
  }
  .runway__progress {
    display: none;
  }
  .runway.is-enhanced {
    height: 260svh;
    padding: 0;
  }
  .runway.is-enhanced .runway__sticky {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    height: 100svh;
    overflow: hidden;
    background: var(--color-paper);
  }
  .runway.is-enhanced .runway__track {
    gap: 32px;
    padding: 0;
    overflow: visible;
    scroll-snap-type: none;
    will-change: transform;
  }
  .runway.is-enhanced .runway__slide {
    flex: 0 0 auto;
    width: min(58vw, 760px);
    scroll-snap-align: none;
  }
  .runway.is-enhanced .runway__progress {
    display: block;
    position: absolute;
    left: 50%;
    bottom: clamp(18px, 3vw, 34px);
    width: min(42vw, 480px);
    height: 1px;
    overflow: hidden;
    background: var(--color-rule);
    transform: translateX(-50%);
  }
  .runway.is-enhanced .runway__progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-ink);
    transform: scaleX(0);
    transform-origin: left;
  }
  @media (max-width: 900px) {
    .runway {
      padding-block: 24px 0;
    }
    .runway__slide {
      flex-basis: 88%;
    }
  }
</style>

<script>
  const runway = document.querySelector<HTMLElement>("[data-runway]");
  const track = runway?.querySelector<HTMLElement>("[data-runway-track]");
  const progress = runway?.querySelector<HTMLElement>("[data-runway-progress]");
  const desktop = window.matchMedia(
    "(min-width: 901px) and (prefers-reduced-motion: no-preference)",
  );

  if (runway && track) {
    let max = 0;
    let ticking = false;

    const measure = () => {
      max = Math.max(0, track.scrollWidth - runway.clientWidth);
    };

    const update = () => {
      if (desktop.matches) {
        const rect = runway.getBoundingClientRect();
        const total = Math.max(1, runway.offsetHeight - window.innerHeight);
        const progressValue = Math.min(1, Math.max(0, -rect.top / total));
        track.style.transform = `translate3d(${-max * progressValue}px, 0, 0)`;
        if (progress) {
          progress.style.transform = `scaleX(${progressValue})`;
        }
      } else {
        const scrollable = track.scrollWidth - track.clientWidth;
        const progressValue =
          scrollable > 0 ? track.scrollLeft / scrollable : 0;
        if (progress) {
          progress.style.transform = `scaleX(${progressValue})`;
        }
      }
      ticking = false;
    };

    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    const enable = () => {
      const enhanced = desktop.matches;
      runway.classList.toggle("is-enhanced", enhanced);
      if (enhanced) {
        measure();
        update();
      } else {
        track.style.transform = "";
      }
    };

    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener(
      "resize",
      () => {
        measure();
        requestUpdate();
      },
      { passive: true },
    );
    track.addEventListener("scroll", requestUpdate, { passive: true });
    desktop.addEventListener("change", enable);
    enable();
  }
</script>
