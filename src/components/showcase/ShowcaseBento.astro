---
import { SHOWCASE } from "@/config/showcase";
---

<section class="bento" aria-label="Google Playのアプリ">
  <div class="bento__grid">
    {SHOWCASE.map((item, index) => (
      <a
        class:list={["bento__tile", `bento__tile--${index + 1}`]}
        data-bento-tile
        href={item.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src={item.src}
          alt={item.alt}
          width="1664"
          height="940"
          loading="eager"
          decoding="async"
          referrerpolicy="no-referrer"
        />
      </a>
    ))}
    <div class="bento__void" aria-hidden="true"></div>
  </div>
</section>

<style>
  .bento {
    padding-block: 48px 0;
  }
  .bento__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px;
    align-items: start;
  }
  .bento__tile {
    display: block;
    overflow: hidden;
    background: var(--color-paper-2);
  }
  .bento__tile img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .bento__tile:hover img {
    transform: scale(1.025);
  }
  .bento__tile--1 {
    grid-column: 1 / 9;
    grid-row: 1;
  }
  .bento__tile--2 {
    grid-column: 9 / 13;
    grid-row: 1;
    align-self: end;
  }
  .bento__tile--3 {
    grid-column: 4 / 13;
    grid-row: 2;
    justify-self: end;
  }
  .bento__void {
    grid-column: 1 / 4;
    grid-row: 2;
    align-self: stretch;
    border-top: 1px solid var(--color-rule);
  }
  .bento__tile.will-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.8s ease,
      transform 1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .bento__tile.will-reveal.is-visible {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 900px) {
    .bento {
      padding-block: 24px 0;
    }
    .bento__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }
    .bento__tile--1,
    .bento__tile--2,
    .bento__tile--3 {
      grid-column: 1 / -1;
      grid-row: auto;
      justify-self: stretch;
      align-self: auto;
    }
    .bento__void {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bento__tile.will-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .bento__tile img {
      transition: none;
    }
  }
</style>

<script>
  const tiles = Array.from(
    document.querySelectorAll<HTMLElement>("[data-bento-tile]"),
  );
  if (
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
    "IntersectionObserver" in window
  ) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.12 },
    );
    for (const tile of tiles) {
      tile.classList.add("will-reveal");
      observer.observe(tile);
    }
  }
</script>
