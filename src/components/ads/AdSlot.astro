---
import { SITE_FEATURES } from "@/config/features";

interface Props {
  slot: string;
  label?: string;
}

const { slot, label = "広告" } = Astro.props;
const client = SITE_FEATURES.adsenseClient;
---

{client && slot ? (
  <aside class="ad-slot" aria-label={label}>
    <ins
      class="adsbygoogle ad-slot__unit"
      data-ad-client={client}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    />
    <script is:inline>
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </aside>
) : null}
