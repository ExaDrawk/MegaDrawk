---
import { SITE } from "@/config/site";
import { SITE_FEATURES } from "@/config/features";
import Header from "@/components/layout/SiteHeader.astro";
import { SiteFooter } from "@/components/layout/SiteFooter";
import { SkipNav } from "@/components/ui/SkipNav";
import { jsonLdScript, personSchema } from "@/lib/structuredData";
import "@/styles/fonts.css";
import "@/styles/globals.css";
interface Props {
  title?: string;
  workspace?: boolean;
  description?: string;
  robots?: { index: boolean; follow: boolean };
  structuredData?: readonly object[];
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  /** サイト相対パス（例: /og/<id>.png）。未指定ならサイト共通カード。 */
  ogImage?: string;
  ogImageAlt?: string;
}
const {
  title = "",
  workspace = false,
  description = SITE.description,
  robots = { index: true, follow: true },
  structuredData = [],
  ogType = "website",
  publishedTime,
  modifiedTime,
  ogImage = "/images/og/default.png",
  ogImageAlt = SITE.name,
} = Astro.props;
const pageTitle = title ? title + " | " + SITE.name : SITE.name;
const canonical = new URL(
  Astro.url.pathname.replace(/\/$/, "") || "/",
  SITE.url,
).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;
const adsense = SITE_FEATURES.adsenseClient;
const beaconToken = SITE_FEATURES.cfWebAnalyticsToken;
const jsonLd = jsonLdScript([personSchema(), ...structuredData]);
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={SITE.keywords.join(", ")} />
    <meta name="author" content={SITE.ownerName} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta
      name="robots"
      content={
        (robots.index ? "index" : "noindex") +
        ", " +
        (robots.follow ? "follow" : "nofollow")
      }
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.name + "のRSS"}
      href={SITE.url + "/rss.xml"}
    />
    <meta
      property="og:type"
      content={ogType === "article" ? "article" : "website"}
    />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.social.xHandle} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {
          // 保存領域が使えない環境ではシステム設定のみに従う
        }
        const initial =
          stored === "light" || stored === "dark"
            ? stored
            : media.matches
              ? "dark"
              : "light";
        const apply = (theme) => {
          root.dataset.theme = theme;
          document.dispatchEvent(
            new CustomEvent("themechange", { detail: { theme } }),
          );
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) {
            const value = getComputedStyle(root)
              .getPropertyValue("--meta-theme-color")
              .trim();
            if (value) meta.setAttribute("content", value);
          }
          const button = document.getElementById("theme-toggle");
          if (button) {
            button.setAttribute(
              "aria-label",
              theme === "dark"
                ? "ライトテーマに切り替え"
                : "ダークテーマに切り替え",
            );
          }
        };
        root.dataset.theme = initial;
        document.addEventListener("DOMContentLoaded", () => apply(initial));
        media.addEventListener("change", (event) => {
          let preference = null;
          try {
            preference = localStorage.getItem("theme");
          } catch {
            // 同上
          }
          if (preference === "light" || preference === "dark") return;
          apply(event.matches ? "dark" : "light");
        });
        document.addEventListener("click", (event) => {
          if (!(event.target instanceof Element)) return;
          if (!event.target.closest("#theme-toggle")) return;
          const next = root.dataset.theme === "dark" ? "light" : "dark";
          try {
            localStorage.setItem("theme", next);
          } catch {
            // 保存できなくても今回の表示は切り替える
          }
          apply(next);
        });
      })();
    </script>
    {adsense && (
      <script
        is:inline
        async
        src={
          "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=" +
          adsense
        }
        crossorigin="anonymous"
      ></script>
    )}
    {beaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beaconToken })}
      ></script>
    )}
  </head>
  <body class="site-body antialiased">
    <SkipNav />
    <div class="page-container">
      <Header />
      <main
        id="main-content"
        class:list={["page-main", { "page-main--workspace": workspace }]}
      >
        <slot />
      </main>
      <SiteFooter />
    </div>
    <script>
      import "@/lib/imageLightbox";
    </script>
  </body>
</html>
