---
import Layout from "@/layouts/Layout.astro";
import { getBlogTagCounts, getPublishedBlogPosts } from "@/config/blog";
import PostList from "@/components/blog/PostList.astro";

export async function getStaticPaths() {
  const tags = await getBlogTagCounts();
  return tags.map(({ tag }) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const posts = (await getPublishedBlogPosts()).filter((post) =>
  post.tags.includes(tag),
);
---

<Layout
  title={`#${tag}の記事`}
  description={`MEGADRAWKのブログのうち、タグ#${tag}が付いた記事一覧。`}
>
  <section class="page-section" aria-labelledby="tag-title">
    <a class="text-link" href="/blog">
      記事一覧に戻る
    </a>
    <header class="page-header">
      <h1 id="tag-title" class="page-title">
        {"#" + tag}
      </h1>
      <p class="document-meta">{posts.length}件の記事</p>
    </header>

    <div class="max-w-3xl">
      {posts.length > 0 ? (
        <PostList posts={posts} showTags={false} />
      ) : (
        <p class="text-sm" data-color="color-text-secondary">
          このタグの記事はまだありません。
        </p>
      )}
    </div>
  </section>
</Layout>
