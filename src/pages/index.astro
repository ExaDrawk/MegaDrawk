---
import Layout from "@/layouts/Layout.astro";
import ShowcaseRunway from "@/components/showcase/ShowcaseRunway.astro";
import { PROJECTS } from "@/config/projects";
import { SITE } from "@/config/site";
import { itemListSchema, websiteSchema } from "@/lib/structuredData";
---

<Layout
  description={SITE.description}
  wide
  structuredData={[websiteSchema(), itemListSchema(PROJECTS)]}
>
  <h1 class="visually-hidden">{SITE.name}</h1>
  <ShowcaseRunway wide />
</Layout>
