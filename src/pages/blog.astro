---
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config/site";
import { getPublishedBlogPosts } from "@/config/blog";
import PostList from "@/components/blog/PostList.astro";
const posts = await getPublishedBlogPosts();
---

<Layout title="Blog" description={SITE.name + "のブログ。制作記録とメモ。"}>
  <div>
    <section class="page-section" aria-labelledby="blog-title">
      <header class="page-header">
        <h1
          id="blog-title"
          class="page-title text-3xl sm:text-4xl font-bold tracking-tight"
        >
          Blog
        </h1>
      </header>

      <div class="mt-8 max-w-3xl">
        {posts.length > 0 ? (
          <PostList posts={posts} />
        ) : (
          <div>
            <p class="text-sm" data-color="color-text-secondary">
              まだ記事はありません。
            </p>
          </div>
        )}
      </div>
    </section>
  </div>
</Layout>
