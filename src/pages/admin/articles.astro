---
import Layout from "@/layouts/Layout.astro";
import { AdminArticles } from "@/components/admin/AdminArticles";
---

<Layout title="記事管理" robots={{ index: false, follow: false }}>
  <section class="page-section">
    <header class="page-header">
      <h1 class="page-title text-3xl font-bold tracking-tight">記事管理</h1>
      <p class="page-description mt-2">
        Markdownのまま記事を追加・編集・削除します。保存するとGitHubにコミットされ、1〜2分でサイトに反映されます。
      </p>
    </header>
    <AdminArticles client:load />
  </section>
</Layout>
