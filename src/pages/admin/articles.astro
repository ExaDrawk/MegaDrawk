---
import Layout from "@/layouts/Layout.astro";
import { AdminArticlesScreen as AdminArticles } from "@/components/admin/AdminArticles";
---

<Layout title="記事管理" robots={{ index: false, follow: false }}>
  <section class="page-section">
    <header class="page-header">
      <h1 class="page-title text-3xl font-bold tracking-tight">記事管理</h1>
      <p class="page-description mt-2">
        記事の編集と公開・非公開の切り替えができます。非公開の記事は、管理者としてログインしている間だけ確認できます。保存後、通常1〜2分で反映されます。
      </p>
    </header>
    <AdminArticles client:load />
  </section>
</Layout>
