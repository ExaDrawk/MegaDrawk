# 広告（ca-pub- + 16桁）。未設定なら広告スクリプトを出力しない。
# 広告コードはトップ・About・ブログ・記事・タグページにのみ出力する（法務・連絡・404・管理画面は除く）。
PUBLIC_ADSENSE_CLIENT=
# 記事内の手動広告ユニットのスロットID（数字）。未設定なら広告枠を出力しない。
# サイト承認後にAdSenseでユニットを作成して設定する。
PUBLIC_ADSENSE_ARTICLE_SLOT=
# Cloudflare Turnstileサイトキー（0x + 22文字）。未設定ならお問い合わせフォームを出力しない。
# functions/api/contact.ts の実行にはCloudflare Pages環境変数の TURNSTILE_SECRET_KEY / BREVO_API_KEY も必要。
PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Web Analyticsビーコントークン（32桁の16進数）。未設定ならビーコンを出力しない。
PUBLIC_CF_WEB_ANALYTICS_TOKEN=
