{
  "name": "megadrawk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "verify:static": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "build": "npm run verify:static && astro build",
    "start": "astro preview --host 127.0.0.1 --port 3000",
    "lint": "eslint \"src/**/*.{ts,tsx,astro}\" astro.config.mjs vitest.config.ts playwright.config.ts",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,astro}\" astro.config.mjs vitest.config.ts playwright.config.ts --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,astro}\" astro.config.mjs vitest.config.ts playwright.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,astro}\" astro.config.mjs vitest.config.ts playwright.config.ts",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "astro preview --host 127.0.0.1 --port 3000",
    "check": "npm run build && npm run test:coverage && npm run e2e",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "astro": "^7.2.9",
    "lucide-react": "^0.563.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "~3.1.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "minimatch": "^10.2.3",
    "undici": "^7.24.0",
    "postcss": "^8.5.10"
  }
}
