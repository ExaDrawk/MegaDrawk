{
  "name": "megadrawk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/prepare-static.mjs",
    "start": "node scripts/serve-static.mjs",
    "preview": "node scripts/serve-static.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "node scripts/private-blog.mjs --init && astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "check:encoding": "node scripts/check-encoding.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check:encoding && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "deploy": "npm run check && wrangler pages deploy dist --project-name megadrawk",
    "verify": "node scripts/verify.mjs",
    "sync:stores": "node scripts/sync-stores.mjs",
    "assets:generate": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "astro": "^7.4.2",
    "lucide-react": "^0.563.0",
    "marked": "^18.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "satori": "^0.63.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261025.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "jsdom": "^28.1.0",
    "parse5": "^8.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  },
  "overrides": {
    "minimatch": "^10.2.3",
    "undici": "^7.30.1",
    "postcss": "^8.5.10",
    "fflate": "^0.8.2"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
