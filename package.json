{
  "name": "megadrawk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src middleware.ts next.config.mjs vitest.config.ts open-next.config.ts",
    "lint:fix": "eslint src middleware.ts next.config.mjs vitest.config.ts open-next.config.ts --fix",
    "typecheck": "tsc --noEmit",
    "opennext:build": "npx @opennextjs/cloudflare build",
    "deploy": "next build && npx @opennextjs/cloudflare build && node scripts/prepare-pages.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "lucide-react": "^0.563.0",
    "next": "^16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.5",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.11.30",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "minimatch": "^10.2.3",
    "undici": "^7.24.0",
    "postcss": "^8.5.10"
  }
}
